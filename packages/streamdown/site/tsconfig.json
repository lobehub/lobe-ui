{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@lobehub/streamdown": ["../src"],
      "@lobehub/streamdown/profiler": ["../src/profiler"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "es2020"
  },
  "include": ["src", "vite.config.ts"]
}
